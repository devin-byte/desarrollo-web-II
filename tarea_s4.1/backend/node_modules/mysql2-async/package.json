{
  "name": "mysql2-async",
  "version": "2.0.5",
  "description": "A wrapper for mysql2 to add convenience, especially when developing with async/await and async iterables.",
  "type": "commonjs",
  "exports": {
    ".": {
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "import": {
        "types": "./lib-esm/index.d.ts",
        "default": "./lib-esm/index.js"
      }
    },
    "./db": {
      "require": {
        "types": "./lib/db.d.ts",
        "default": "./lib/db.js"
      },
      "import": {
        "types": "./lib-esm/db.d.ts",
        "default": "./lib-esm/db.js"
      }
    }
  },
  "types": "./lib-esm/index.d.ts",
  "typesVersions": {
    "*": {
      "db": [
        "./lib-esm/db.d.ts"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "rm -rf ./lib && tsc && cp lib/*.d.ts lib-esm/",
    "build:test": "rm -rf ./dist-test && tsc -p tsconfig.test.json",
    "test:integration": "npm run build:test && node --enable-source-maps --test --test-isolation=none dist-test/test/*.js",
    "lint": "eslint src test",
    "test": "./test.sh"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chai": "^5.2.3",
    "@types/node": "^26.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.10.0",
    "eslint-config-love": "^157.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "mysql2": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txstate-etc/mysql2-async.git"
  },
  "keywords": [
    "mysql",
    "txstate"
  ],
  "author": "Nick Wing",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/txstate-etc/mysql2-async/issues"
  },
  "homepage": "https://github.com/txstate-etc/mysql2-async#readme",
  "files": [
    "lib/**/*",
    "lib-esm/**/*"
  ]
}
